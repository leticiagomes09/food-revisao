generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
}

model food {
    id        Int      @id @default(autoincrement())
    nome      String
    descricao String
    categoria String
    preco     Decimal
    disponibilidade Boolean
    createdAt DateTime @default(now())


    @@map("food")
}
